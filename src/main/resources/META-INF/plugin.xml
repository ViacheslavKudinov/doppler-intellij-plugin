<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.viacheslavkudinov.doppler</id>
    <name>Doppler Secrets Manager (Unofficial)</name>
    <vendor url="https://github.com/ViacheslavKudinov/doppler-plugin/issues">Viacheslav Kudinov</vendor>

    <description><![CDATA[
        <p>Browse, edit, and synchronize your <a href="https://doppler.com">Doppler</a> secrets without leaving your IDE.</p>

        <p><b>Unofficial, independently developed plugin.</b> Not affiliated with, endorsed by, or supported by Doppler.
        Doppler's name and trademarks belong to Doppler Technologies, Inc. The plugin uses an original icon.</p>

        <h3>Features</h3>
        <ul>
            <li><b>Browse secrets</b> &mdash; explore projects, environments, and configs in the Doppler tool window.</li>
            <li><b>Edit as YAML</b> &mdash; open a config in an editor tab, including multiline values and restricted-secret placeholders.</li>
            <li><b>Save to synchronize</b> &mdash; saving pushes a minimal set of changes to Doppler.
                Reload or use automatic refresh to retrieve remote changes.</li>
            <li><b>Secret-reference completion</b> &mdash; get completion suggestions for Doppler secret references while editing.</li>
            <li><b>Setup guidance</b> &mdash; detect a missing CLI or login and access installation and authentication instructions.</li>
        </ul>

        <h3>Secret handling</h3>
        <p>Opened secret documents are held in memory rather than saved as local project files.
        Secret values are passed to the Doppler CLI through standard input, not command-line arguments.</p>
        <p>Authentication is managed by the Doppler CLI through <code>doppler login</code>.
        The plugin does not store your authentication token.</p>

        <h3>Requirements</h3>
        <ul>
            <li>IntelliJ Platform <b>2025.3 (build 253) or later</b>.</li>
            <li>The <b>Terminal plugin</b> installed and enabled.</li>
            <li>The <a href="https://docs.doppler.com/docs/install-cli">Doppler CLI</a> installed and authenticated.</li>
        </ul>
        ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.plugins.terminal</depends>

    <extensions defaultExtensionNs="com.intellij">
        <ide.dynamicPluginVetoer implementation="com.vk.doppler.DopplerPluginUnloadVetoer"/>

        <toolWindow id="Doppler"
                    anchor="right"
                    factoryClass="com.vk.doppler.toolwindow.DopplerToolWindowFactory"
                    icon="/icons/doppler.svg"/>

        <applicationService serviceImplementation="com.vk.doppler.settings.DopplerSettings"/>
        <applicationService serviceImplementation="com.vk.doppler.service.DopplerService"/>
        <projectService serviceImplementation="com.vk.doppler.editor.DopplerSecretsEditorService"/>

        <applicationConfigurable parentId="tools"
                                 instance="com.vk.doppler.settings.DopplerConfigurable"
                                 id="com.vk.doppler.settings.DopplerConfigurable"
                                 displayName="Doppler"/>
        <projectConfigurable parentId="com.vk.doppler.settings.DopplerConfigurable"
                             instance="com.vk.doppler.settings.DopplerFolderSetupConfigurable"
                             id="com.vk.doppler.settings.DopplerFolderSetupConfigurable"
                             displayName="Folder Setup"
                             nonDefaultProject="true"/>

        <virtualFileSystem key="doppler"
                           implementationClass="com.vk.doppler.editor.DopplerFileSystem"
                           physical="false"/>

        <editorTabTitleProvider implementation="com.vk.doppler.editor.DopplerEditorTabTitleProvider"/>
        <fileIconProvider implementation="com.vk.doppler.editor.DopplerFileIconProvider"/>
        <virtualFilePreCloseCheck implementation="com.vk.doppler.editor.DopplerFileCloseCheck"/>
        <completion.contributor language="any"
                                implementationClass="com.vk.doppler.completion.DopplerSecretReferenceCompletionContributor"/>
        <typedHandler implementation="com.vk.doppler.completion.DopplerSecretReferenceTypedHandler"/>

        <notificationGroup id="Doppler" displayType="BALLOON"/>
    </extensions>
    <projectListeners>
        <listener class="com.vk.doppler.completion.SecretReferenceClickSelection"
                  activeInTestMode="true"
                  topic="com.intellij.codeInsight.lookup.LookupManagerListener"/>
    </projectListeners>
</idea-plugin>
