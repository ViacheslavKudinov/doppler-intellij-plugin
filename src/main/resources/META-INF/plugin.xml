<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.viacheslavkudinov.doppler</id>
    <name>Doppler Secrets Manager (Unofficial)</name>
    <vendor url="https://kudinov.tech">Viacheslav Kudinov</vendor>

    <description><![CDATA[
        <p><b>Unofficial, independently developed plugin.</b> Not affiliated with, endorsed by,
        or supported by Doppler. Doppler's name, trademarks, and copyrighted materials belong to <b>Doppler Technologies, Inc</b>.
        The plugin uses an original icon, not the official Doppler logo.<br></p>
        <p>Browse and edit your <a href="https://doppler.com">Doppler</a> secrets without leaving the IDE.</p>
        <ul>
            <li><b>Projects tree</b> &mdash; browse projects, environments and configs in a dedicated tool window.</li>
            <li><b>Edit secrets</b> &mdash; open a config to edit its secrets in a virtual editor tab.
                Secrets are held in memory only and are never written to disk.</li>
            <li><b>Two-way sync</b> &mdash; saving the tab pushes a minimal diff back to Doppler;
                reload at any time to pull the latest values.</li>
        </ul>
        Requires the <a href="https://docs.doppler.com/docs/install-cli">Doppler CLI</a> to be installed and
        authenticated via <code>doppler login</code>. The plugin never stores or transmits your token.
        ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.plugins.terminal</depends>

    <extensions defaultExtensionNs="com.intellij">
        <ide.dynamicPluginVetoer implementation="com.vk.doppler.DopplerPluginUnloadVetoer"/>

        <toolWindow id="Doppler"
                    anchor="right"
                    factoryClass="com.vk.doppler.toolwindow.DopplerToolWindowFactory"
                    icon="/icons/doppler.svg"/>

        <applicationService serviceImplementation="com.vk.doppler.settings.DopplerSettings"/>
        <applicationService serviceImplementation="com.vk.doppler.service.DopplerService"/>
        <projectService serviceImplementation="com.vk.doppler.editor.DopplerSecretsEditorService"/>

        <applicationConfigurable parentId="tools"
                                 instance="com.vk.doppler.settings.DopplerConfigurable"
                                 id="com.vk.doppler.settings.DopplerConfigurable"
                                 displayName="Doppler"/>

        <virtualFileSystem key="doppler"
                           implementationClass="com.vk.doppler.editor.DopplerFileSystem"
                           physical="false"/>

        <editorTabTitleProvider implementation="com.vk.doppler.editor.DopplerEditorTabTitleProvider"/>
        <fileIconProvider implementation="com.vk.doppler.editor.DopplerFileIconProvider"/>
        <virtualFilePreCloseCheck implementation="com.vk.doppler.editor.DopplerFileCloseCheck"/>
        <completion.contributor language="any"
                                implementationClass="com.vk.doppler.editor.DopplerSecretReferenceCompletionContributor"/>
        <typedHandler implementation="com.vk.doppler.editor.DopplerSecretReferenceTypedHandler"/>

        <notificationGroup id="Doppler" displayType="BALLOON"/>
    </extensions>
</idea-plugin>
